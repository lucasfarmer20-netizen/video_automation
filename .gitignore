# Secrets
.env
lucas-pipeline-2026-v1-ec3e767f8c46.json

# Virtual environment
.venv/

# Generated media / large binaries
assets/

# Curated music (owned/licensed, large)
audio_pool/

# Style-LoRA training frames (large)
lora_training/

# Reference images + registry (owned art, cached fal URLs)
references/
references.json

# Python bytecode
__pycache__/
*.pyc

# Rendered clips (generated by the local motion engine)
render/

# Generated audio (narration + sfx)
audio/

# Generated timelines (machine-specific media paths)
*.otio
*.fcpxml

# Temp / output / cache dirs
tmp/
temp/
output/
cache/
.cache/
*.tmp
models/
sizzle/
intro/

# Ad-hoc inspection/migration scratch dirs (never part of a build)
_inspect/
_migrate_tmp/

# Prompt/plan telemetry. ledger.ledger_path() (backend/ledger.py:54-58) resolves
# PROMPT_LEDGER_PATH, then /gcs, then config.ROOT -- and config.ROOT is this
# directory. Deployed, the real ledger lives on the GCS mount and is unaffected
# by this line; locally and under pytest it lands here. Only
# tests/test_ledger_failures.py redirects the env var, so every other test that
# reaches record_plan_outcome() appends to the repo root instead: 1029 rows, all
# stamped with pytest tmp-project names, were sitting here and were swept into a
# commit by a `git add -A`. Test debris must not be committable.
prompt_ledger.jsonl

# (The UI mutation harness used to generate a probe spec here and needed an
# ignore for it. It no longer generates anything -- the probe is a committed
# spec, src/app/page.storage.probe.test.tsx, gated on STORAGE_PROBE=1 -- so
# there is nothing to ignore. Removing a write beats ignoring it.)

# Active-project pointer. main.py:208 resolves it to /gcs/.active_project when
# the mount exists and to Path(".active_project") -- the repository root --
# otherwise, so every local run of the studio writes it here. Tests monkeypatch
# M.ACTIVE_PROJECT_FILE to tmp_path and should keep doing so; this is the
# backstop for the app itself, which cannot.
.active_project
