ELEVENLABS_API_KEY=
FAL_KEY=
ANTHROPIC_API_KEY=

# Optional. fal ADMIN key, used only by backend/fal_usage.py to read the
# account's billed line items (GET /v1/models/usage) so recorded spend can be
# reconciled against the invoice. The ordinary FAL_KEY is refused (403) by that
# endpoint. Leave it unset and reconciliation reports itself unavailable — it
# never reports zero, and nothing else in the pipeline needs it.
FAL_ADMIN_KEY=
